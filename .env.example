# Slack Credentials (from api.slack.com -> Your App)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-level-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Your Personal Slack User ID (find in Slack Profile -> More Options -> Copy Member ID)
# The bot will DM review drafts to this user for approval
SLACK_REVIEWER_USER_ID=U0123456789

# GitHub auth (pick ONE — recommended: GitHub CLI, no PAT in .env)
# Option A (recommended local dev): install `gh`, then run `gh auth login` (repo scope).
# Option B (CI / cloud): classic PAT with `repo` scope from github.com/settings/tokens
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_personal_access_token

# Google Gemini API Key (100% Free from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKey

# Optional: Preferred Gemini Model (defaults to gemini-3.5-flash; auto-falls back to 3.6/3.5-lite/3.8 if unavailable)
# GEMINI_MODEL=gemini-3.5-flash

